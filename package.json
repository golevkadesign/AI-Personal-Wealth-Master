{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.js",
    "build": "vite build && esbuild server.ts --platform=node --packages=external --bundle --format=esm --target=node22 --outfile=dist/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "check:i18n-hardcoded": "node scripts/check-i18n-hardcoded.mjs",
    "check:memory-inbox": "esbuild scripts/check-memory-inbox-lifecycle.ts --platform=node --packages=external --bundle --format=esm --outfile=/tmp/arbitra-memory-inbox-check.mjs && node /tmp/arbitra-memory-inbox-check.mjs",
    "check:workbench-agent-result": "esbuild scripts/check-workbench-agent-result.ts --platform=node --packages=external --bundle --format=esm --outfile=/tmp/arbitra-workbench-agent-result-check.mjs && node /tmp/arbitra-workbench-agent-result-check.mjs",
    "check:workbench-audit": "esbuild scripts/check-workbench-audit-persistence.ts --platform=node --packages=external --bundle --format=esm --outfile=/tmp/arbitra-workbench-audit-check.mjs && node /tmp/arbitra-workbench-audit-check.mjs",
    "check:workbench-widgets": "esbuild scripts/check-workbench-widget-selection.ts --platform=node --packages=external --bundle --format=esm --outfile=/tmp/arbitra-workbench-widget-check.mjs && node /tmp/arbitra-workbench-widget-check.mjs",
    "check:workbench-portfolio-depth": "mkdir -p .tmp && esbuild scripts/check-workbench-portfolio-depth.ts --platform=node --packages=external --bundle --format=esm --outfile=.tmp/arbitra-workbench-portfolio-depth-check.mjs && node .tmp/arbitra-workbench-portfolio-depth-check.mjs",
    "check:workbench-response-widgets": "mkdir -p .tmp && esbuild scripts/check-workbench-response-widgets.ts --platform=node --packages=external --bundle --format=esm --outfile=.tmp/arbitra-workbench-response-widgets-check.mjs && node .tmp/arbitra-workbench-response-widgets-check.mjs",
    "check:workbench-chat-session": "mkdir -p .tmp && esbuild scripts/check-workbench-chat-session-binding.ts --platform=node --packages=external --bundle --format=esm --outfile=.tmp/arbitra-workbench-chat-session-check.mjs && node .tmp/arbitra-workbench-chat-session-check.mjs",
    "check:workbench-events": "esbuild scripts/check-workbench-events.ts --platform=node --packages=external --bundle --format=esm --outfile=/tmp/arbitra-workbench-events-check.mjs && node /tmp/arbitra-workbench-events-check.mjs",
    "check:profile-center": "esbuild scripts/check-profile-center-memory-loop.ts --platform=node --packages=external --bundle --format=esm --outfile=/tmp/arbitra-profile-center-check.mjs && node /tmp/arbitra-profile-center-check.mjs",
    "check:workbench-profile-write-policy": "esbuild scripts/check-workbench-profile-write-policy.ts --platform=node --packages=external --bundle --format=esm --outfile=/tmp/arbitra-workbench-profile-write-policy-check.mjs && node /tmp/arbitra-workbench-profile-write-policy-check.mjs",
    "check:prd2-api-contract": "mkdir -p .tmp && esbuild scripts/check-prd2-api-contract.ts --platform=node --packages=external --bundle --format=esm --outfile=.tmp/arbitra-prd2-api-contract-check.mjs && node .tmp/arbitra-prd2-api-contract-check.mjs",
    "check:prd2-quality": "mkdir -p .tmp && esbuild scripts/check-prd2-quality-gates.ts --platform=node --packages=external --bundle --format=esm --outfile=.tmp/arbitra-prd2-quality-check.mjs && node .tmp/arbitra-prd2-quality-check.mjs",
    "check:prd2-browser-e2e": "node scripts/check-prd2-browser-e2e.mjs",
    "check:longbridge-native": "node scripts/verify-longbridge-native.mjs",
    "check:longbridge-native:required": "node scripts/verify-longbridge-native.mjs --required",
    "check:longbridge-history": "mkdir -p .tmp && esbuild scripts/check-longbridge-history-adapter.ts --platform=node --packages=external --bundle --format=esm --outfile=.tmp/arbitra-longbridge-history-check.mjs && node .tmp/arbitra-longbridge-history-check.mjs",
    "check:longbridge-negative-cost": "mkdir -p .tmp && esbuild scripts/check-longbridge-negative-cost-valuation.ts --platform=node --packages=external --bundle --format=esm --outfile=.tmp/arbitra-longbridge-negative-cost-check.mjs && node .tmp/arbitra-longbridge-negative-cost-check.mjs",
    "check:market-context": "node scripts/check-market-context.mjs",
    "check:market-context:force": "node scripts/check-market-context.mjs --force"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/react": "^3.0.170",
    "@fontsource/material-symbols-rounded": "^5.2.45",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "ai": "^6.0.168",
    "axios": "^1.15.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "echarts": "^6.0.0",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "lodash-es": "^4.18.1",
    "longbridge": "^4.3.0",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0",
    "yahoo-finance2": "^3.14.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "firebase-tools": "^15.19.1",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
